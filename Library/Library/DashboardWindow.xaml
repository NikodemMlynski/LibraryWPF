<Window x:Class="Library.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        xmlns:vm="clr-namespace:Library.ViewModels.Reader"
        xmlns:views="clr-namespace:Library.Views.Reader"
        mc:Ignorable="d"
        Title="BookFlow - Dashboard" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookListPageViewModel}">
            <views:BookListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserRentalsPageViewModel}">
            <views:UserRentalsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserProfilePageViewModel}">
            <views:UserProfilePage />
        </DataTemplate>

        <Style TargetType="Button" x:Key="SidebarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0B2B45"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15 10"/>
            <Setter Property="Margin" Value="0 8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#150B2B45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="LogoutButton" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#FF5252"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7070"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="#FDF9F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*"/>
            <ColumnDefinition Width="0.75*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FDF9F5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20 20 20 10">
                    <TextBlock Text="BookFlow" FontSize="30" FontWeight="Bold" 
                               Foreground="#45A7FF" Margin="0 0 0 40" HorizontalAlignment="Center"/>

                    <TextBlock 
                        Text="{Binding CurrentUser.Name}" 
                        FontSize="16" 
                        Margin="0,5,0,20" 
                        HorizontalAlignment="Center" 
                        FontWeight="SemiBold"
                               />

                    <Button Content="Dashboard" Style="{StaticResource SidebarButton}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="DashboardPageViewModel"
                            Padding="30 20"/>
                    <Button Content="Books" Style="{StaticResource SidebarButton}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="BookListPageViewModel"/>

                    <Button Content="Your rentals" Style="{StaticResource SidebarButton}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="UserRentalsPageViewModel"/>

                    <Button Content="Profile" Style="{StaticResource SidebarButton}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="UserProfilePageViewModel"/>
                </StackPanel>

                <Button Grid.Row="1"
                        Content="Log out" 
                        Style="{StaticResource LogoutButton}" 
                        Margin="20 10 20 20"
                        Padding="20 20" Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#FDF9F5">
            <ContentControl Content="{Binding CurrentPageViewModel}"/>
        </Border>
    </Grid>
</Window>