<UserControl x:Class="Library.Views.Shared.BookManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Library.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBox" x:Key="FormTextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0 5 0 15"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15 10"/>
        </Style>

        <Style x:Key="ContentCellElementStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="15 10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FDF9F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30 30 30 10">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" Foreground="#0B2B45"/>
            <Button Content="+ Dodaj Książkę" HorizontalAlignment="Right"
                    Background="#45A7FF" Foreground="White" Padding="20 10" BorderThickness="0"
                    Command="{Binding OpenAddModalCommand}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <DataGrid Grid.Row="1" Margin="30 10 30 30"
                  ItemsSource="{Binding Books}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#E0E0E0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource ContentCellElementStyle}"/>
                <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource ContentCellElementStyle}"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*" ElementStyle="{StaticResource ContentCellElementStyle}"/>
                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="80" ElementStyle="{StaticResource ContentCellElementStyle}"/>

                <DataGridTemplateColumn Header="Akcje" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="Update" Margin="0 0 5 0" Padding="10 5"
                                        Background="#0d6efd" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.EditBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Delete" Padding="10 5"
                                        Background="#dc3545" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" Width="400" VerticalAlignment="Center" CornerRadius="15" Padding="30">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

                    <TextBlock Text="Tytuł"/>
                    <TextBox Text="{Binding NewTitle}" Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Autor"/>
                    <TextBox Text="{Binding NewAuthor}" Style="{StaticResource FormTextBox}"/>

                    <TextBlock Text="Ilość"/>
                    <TextBox Text="{Binding NewQuantity}" Style="{StaticResource FormTextBox}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
                        <Button Content="Anuluj" Width="100" Height="35" Margin="0 0 10 0"
                                Background="Transparent" BorderBrush="#CCC" BorderThickness="1"
                                Command="{Binding CloseAddModalCommand}"/>

                        <Button Content="{Binding ModalButtonText}" Width="120" Height="35"
                                Background="#45A7FF" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                Command="{Binding SaveOrUpdateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>