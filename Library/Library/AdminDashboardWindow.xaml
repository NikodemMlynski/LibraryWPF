<Window x:Class="Library.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        
          xmlns:vmAdmin="clr-namespace:Library.ViewModels.Admin"
          xmlns:viewsAdmin="clr-namespace:Library.Views.Admin"
        
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="500" Width="850">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vmAdmin:DashboardPageViewModel}">
            <viewsAdmin:DashboardPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmAdmin:BookManagerPageViewModel}">
            <viewsAdmin:BookManagerPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmAdmin:LibrarianManagerPageViewModel}">
            <viewsAdmin:LibrarianManagerPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmAdmin:ReaderManagerPageViewModel}">
            <viewsAdmin:ReadersManagerPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmAdmin:RentalsManagerPageViewModel}">
            <viewsAdmin:RentalsManagerPage />
        </DataTemplate>

        <Style TargetType="Button" x:Key="SidebarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0B2B45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FDF9F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0 0 1 0">
            <StackPanel Margin="10">
                <TextBlock Text="Admin Panel" FontSize="22" FontWeight="Bold" Margin="0 0 0 30" Foreground="#45A7FF"/>

                <Button Content="Dashboard" Style="{StaticResource SidebarButton}"
                 Command="{Binding NavigateCommand}" 
                 CommandParameter="DashboardPageViewModel"/>

                <Button Content="Books" Style="{StaticResource SidebarButton}"
                 Command="{Binding NavigateCommand}" 
                 CommandParameter="BookManagerPageViewModel"/>

                <Button Content="Rentals" Style="{StaticResource SidebarButton}"
                 Command="{Binding NavigateCommand}" 
                 CommandParameter="RentalsManagerPageViewModel"/>

                <Button Content="Librarians" Style="{StaticResource SidebarButton}"
                 Command="{Binding NavigateCommand}" 
                 CommandParameter="LibrarianManagerPageViewModel"/>

                <Button Content="Readers" Style="{StaticResource SidebarButton}"
                 Command="{Binding NavigateCommand}" 
                 CommandParameter="ReaderManagerPageViewModel"/>

                <Rectangle Height="50" Visibility="Hidden"/>

                <Button Content="Log out" Background="#FF5252" Foreground="White" Padding="10"
                 Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="20">
            <ContentControl Content="{Binding CurrentPageViewModel}" />
        </Border>
    </Grid>
</Window>
